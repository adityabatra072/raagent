{
  "name": "raagent",
  "version": "0.1.0",
  "private": true,
  "description": "RunAnywhere Agent — on-device agentic AI demo app (iOS + Android) built on the RunAnywhere SDKs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "eval": "npm run start -w @raagent/eval --"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
